# Copy to `.env` to turn the team layer on. Without it the app is local-only and everything
# except team sync and the shared library works exactly the same — that is the design, not a
# degraded mode.
#
# Neither value is a secret. The anon key is meant to ship inside a client; what it can actually
# reach is decided by the row-level security policies in `supabase/migrations/`, not by hiding
# it. The Anthropic key is the one real secret in this project and it never goes in a file —
# see the Anthropic section of CLAUDE.md.
#
# Both are read at build time (Vite inlines anything prefixed `VITE_`), so changing them means
# restarting the dev server or rebuilding.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --------------------------------------------------------------------------
# Claude coaching (optional, and off). Layer A — the offline depth panel —
# always runs and is unaffected by everything below.
# --------------------------------------------------------------------------
#
# The coach panel does not appear at all unless this is switched on. It is a separate switch from
# the key on purpose: ANTHROPIC_API_KEY is a de-facto standard that is often already exported for
# other tools, and a panel that turned itself on because of that would make billed calls nobody
# asked for. Accepts true / 1 / yes / on; anything else, including absent, is off.

VITE_ENABLE_COACH=

#
# **This one IS a secret**, unlike the two above. Note there is no VITE_ prefix and there must
# never be one: Vite inlines anything prefixed `VITE_` into the frontend bundle, which would
# write the key into the webview's JavaScript and ship it inside the installer. Without the
# prefix it is invisible to Vite and is read only by the Rust shell, which is what makes the
# request.
#
# A real environment variable is better than this file: `.env` is plaintext on disk, and in this
# project's case inside a OneDrive-synced folder. Set it once and restart your terminal —
#
#   setx ANTHROPIC_API_KEY "sk-ant-..."
#
# The line below is the convenience path for a dev run. Read at launch, so a change needs the
# app restarting.

ANTHROPIC_API_KEY=
